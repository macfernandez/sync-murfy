MURFY_EMAIL=tu@email.com
MURFY_PASSWORD=tupassword
# Nombre (o parte del nombre) del proyecto a sincronizar.
# Localmente se lee de aquí; en GitHub Actions se pasa como variable del repo
# (vars.MURFY_PROJECT en el YAML, no como secret).
# Si se deja vacío se abre el primer proyecto de la lista.
MURFY_PROJECT=
